---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Simplifying Complexity",
    subTitle:
      "At A4B, we simplify the intricate landscape of digital transformation. By leveraging cutting-edge technologies and a refined tech stack, we empower businesses with actionable intelligence and clear insights to drive success.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Blueprints showcasing streamlined workflows.",
    imgTwo: personWorking,
    imgTwoAlt: "Person working on a strategic digital transformation plan.",
  },
  {
    isRightSection: false,
    title: "Client-Centricity",
    subTitle:
      "A4B places clients at the core of every solution. Our platforms are designed to help businesses navigate digital complexities, ensuring informed decision-making and sustainable growth.",
    img: beforeAfter,
    imgAlt: "Before and after implementing A4B's innovative solutions.",
    btnExists: true,
    btnTitle: "Learn More",
    btnURL: "#",
  },
  {
    isRightSection: true,
    title: "Streamlining Processes with Intelligent Oversight",
    subTitle:
      "A4B simplifies process management with comprehensive tools for resource allocation, workflow optimization, and communication management. Our solutions ensure your business runs smoothly and efficiently.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Team collaborating on a streamlined workflow.",
    imgTwo: aerialView,
    imgTwoAlt: "Aerial view of optimized business operations.",
  },
  {
    isRightSection: false,
    title: "Ensuring Long-term Success with Robust Support",
    subTitle:
      "Our commitment doesn't end at deployment. A4B provides ongoing support and updates to ensure our solutions evolve with your business, delivering long-term value and reliability.",
    img: usingTools,
    imgAlt: "Team providing technical support and updates.",
  },
  {
    isRightSection: true,
    title: "Crafting Custom Strategies for Complex Needs",
    subTitle:
      "At A4B, we specialize in tailored strategies to address the unique challenges of each client. By leveraging advanced technologies, we deliver innovative, scalable, and efficient solutions.",
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: "Progressive building illustrating a scalable solution.",
    imgTwo: underConstruction,
    imgTwoAlt: "Digital framework under development for transformation.",
    btnExists: true,
    btnTitle: "Read more",
    btnURL: "#",
  },
];

const pageTitle: string = `About Us | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://a4b.com/about-us",
    "url": "https://a4b.com/about-us",
    "name": "About Us | A4B",
    "description": "Discover A4B's vision of clarity, efficiency, and client-centric digital transformation. Learn how we empower businesses with innovative solutions and unwavering support.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://a4b.com",
      "name": "A4B",
      "description": "A4B delivers cutting-edge digital solutions, empowering businesses to streamline operations and enhance profitability.",
    },
    "inLanguage": "en-US"
  }}
>
  <!-- Main Section -->
  <MainSection
    title="The A4B Vision"
    subTitle="Clear solutions, superior efficiency. At A4B, we redefine digital transformation with clarity, precision, and a commitment to excellence."
    btnExists={true}
    btnTitle="Discover Our Solutions"
    btnURL="/services"
  />

  <!-- Articles Section -->
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <!-- Features Stats -->
  <FeaturesStats
    title="Our Impact in Numbers"
    subTitle="A4B’s innovative solutions and client-centric approach have empowered businesses globally. Here's how we make a difference."
    mainStatTitle="98%"
    mainStatSubTitle="of our clients report improved efficiency with A4B solutions"
    stats={[
      {
        stat: "100%",
        description: "transparent processes for all projects",
      },
      {
        stat: "10,000+",
        description: "businesses transformed worldwide",
      },
      {
        stat: "90%",
        description: "year-over-year client retention rate",
      },
    ]}
  />

  <!-- The A4B Difference Section -->
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="text-center">
      <h2
        class="text-4xl font-extrabold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl"
      >
        The A4B Difference
      </h2>
      <p
        class="mt-4 text-lg text-neutral-600 dark:text-neutral-400"
      >
        A4B is more than just a technology provider; we embody a philosophy of being "present" throughout our clients’ journeys. Unlike traditional models, A4B offers personalized support and insightful guidance, transforming the client experience and redefining relationships within the digital landscape.
      </p>
    </div>
  
    <!-- Feature Highlights -->
    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col items-center text-center">
        <div class="mb-4">
          <svg
            class="h-12 w-12 text-orange-500 dark:text-orange-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200">
          Streamlined Efficiency
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          We prioritize clear, effective solutions that enhance operational efficiency without unnecessary complexity.
        </p>
      </div>
      <div class="flex flex-col items-center text-center">
        <div class="mb-4">
          <svg
            class="h-12 w-12 text-orange-500 dark:text-orange-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3.75l-6 6h15l-6-6m0 0V20.25" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200">
          Advanced Technology
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          Utilizing a robust and refined tech stack, we deliver cutting-edge solutions that are both innovative and reliable.
        </p>
      </div>
      <div class="flex flex-col items-center text-center">
        <div class="mb-4">
          <svg
            class="h-12 w-12 text-orange-500 dark:text-orange-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200">
          Expert Teams
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          Our dedicated professionals bring deep expertise and a passion for excellence, ensuring exceptional results for every project.
        </p>
      </div>
      <div class="flex flex-col items-center text-center">
        <div class="mb-4">
          <svg
            class="h-12 w-12 text-orange-500 dark:text-orange-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.75 7.75l-7.5 7.5m0 0l-7.5-7.5m7.5 7.5v7" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200">
          Comprehensive Support
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          From development to managed services, we provide end-to-end support that ensures seamless integration and sustained success.
        </p>
      </div>
      <div class="flex flex-col items-center text-center">
        <div class="mb-4">
          <svg
            class="h-12 w-12 text-orange-500 dark:text-orange-400"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7.25L12 3.25l-4 4m4-4v16m0-16L6 7.25M6 7.25L12 13" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200">
          User-Centric Design
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
          Our solutions are designed with the end-user in mind, ensuring intuitive interfaces and enhanced user experiences.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Our Commitment Section -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="text-center">
      <h2
        class="text-4xl font-extrabold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-5xl"
      >
        Our Commitment
      </h2>
      <p
        class="mt-4 text-lg text-neutral-600 dark:text-neutral-400"
      >
        "Simplicity is not about ease, but about clarity and correctness in approach." At A4B, we are unwavering in our pursuit of streamlined, efficient solutions. We focus on delivering clear, actionable, and effective strategies that propel businesses forward.
      </p>
    </div>
  </section>
  

</MainLayout>
