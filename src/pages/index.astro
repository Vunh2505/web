---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import ClientsSection from "@components/sections/landing/ClientsSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import AnnouncementBanner from "@components/ui/banners/AnnouncementBanner.astro";
import heroImage from "@images/A_Top_5_Digital_Transformation_Tools__2x_2x-20230427210412-942.png";
import faqs from "@data/faqs.json";
import features from "@data/features.json";
import pricing from "@data/pricing.json";
import featureImage from "@images/custom-solution-1-1024x702.webp";
import construction from "@images/construction-image.avif";
import tools from "@images/digitaltransformation.webp";
import dashboard from "@images/dashboard-image.avif";

const avatarSrcs: Array<string> = [
  "https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80",
  "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80",
];
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Explore us on Facebook"
    url="#"
  />

  <HeroSection
    title=`Empower Your Business with <span
        class="text-orange-500 dark:text-orange-400">A4B</span>`
    subTitle="Leading-edge software solutions and digital transformation expertise for all your enterprise needs."
    primaryBtn="Start Exploring"
    primaryBtnURL="/products"
    secondaryBtn="Contact Sales Team"
    secondaryBtnURL="/contact"
    withReview={true}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.8</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
    src={heroImage}
    alt="Illustration of A4B's software solutions empowering businesses with digital transformation tools"
  />

  <ClientsSection
  title="Trusted by Industry Innovators"
  subTitle="Empowering enterprises worldwide with cutting-edge digital solutions."
/>


<FeaturesGeneral
    title="Addressing Enterprise Challenges"
    subTitle="At A4B, we tackle the unique challenges faced by modern businesses. From process optimization to intelligent automation, we are committed to streamlining your operations and driving success."
    src={featureImage}
    alt="A4B's digital solutions transforming enterprise workflows"
    features={features}
	
/>


<FeaturesNavs
title=`Customize <span class="text-yellow-500 dark:text-yellow-400">A4B</span>'s solutions to align with your business objectives.`
tabs={[
  {
	heading: "Integrated Platforms",
	content:
	  "Leverage A4B's integrated platforms like xPlatform and xFlow to optimize processes and enhance operational efficiency. Our seamless solutions ensure reliability and scalability.",
	svg: "integration",
	src: tools,
	alt: "A representation of seamless backend integration",
	first: true,
  },
  {
	heading: "User-Centric Dashboards",
	content:
	  "Navigate with ease using A4B's intuitive dashboards. Designed for user-friendly interactions, they simplify workflow management and improve decision-making.",
	svg: "dashboard",
	src: dashboard,
	alt: "A screenshot of A4B's intuitive dashboard interface",
	second: true,
  },
  {
	heading: "Automation and AI",
	content:
	  "Enhance productivity with A4B's AI-driven tools and automation capabilities. Our xBot solution redefines efficiency and supports intelligent decision-making.",
	svg: "automation",
	src: construction,
	alt: "Visualization of intelligent automation enhancing workflows",
  },
]}
/>


<TestimonialsSection
title="Accelerate Your Digital Transformation"
subTitle="A4B empowers your enterprise with advanced digital solutions tailored to your needs."
testimonials={[
  {
	content:
	  "A4B has revolutionized our business operations. Their intuitive solutions and quick deployment have significantly enhanced our efficiency. A trusted partner in our digital transformation journey!",
	author: "Samantha Ruiz",
	role: "Chief Operating Officer | InnovateTech Inc.",
	avatarSrc:
	  "https://images.unsplash.com/photo-1593104547489-5cfb3839a3b5?q=80&w=1453&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
  },
]}
statistics={[
  {
	count: "100k+",
	description:
	  "businesses empowered with our digital solutions",
  },
  {
	count: "40%",
	description:
	  "increase in operational efficiency with A4B platforms",
  },
  {
	count: "20%",
	description:
	  "reduction in process costs through automation and AI",
  },
  {
	count: "2x",
	description: "faster implementation with user-friendly solutions",
  },
]}
/>

  <PricingSection pricing={pricing} />

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />

  <HeroSectionAlt
  title="Let's Transform Together"
  subTitle="A4B provides enterprise-grade digital solutions, built on robust frameworks like Astro, Tailwind CSS, and Preline UI, to empower your business."
  url="https://github.com/A4B-Digital-Solutions"
/>

</MainLayout>
