---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Empowering Businesses with Tailored Solutions",
    subTitle:
      "Navigating digital transformation can be complex. At A4B, we guide you through every step, ensuring informed decisions and seamless implementation. Our experts provide personalized advice on platform customization, integration strategies, and operational efficiency.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Digital blueprints and strategic planning tools.",
    imgTwo: personWorking,
    imgTwoAlt: "Person working on a digital transformation plan.",
  },
  {
    isRightSection: false,
    title: "Transforming Operations with Innovative Tools",
    subTitle:
      "A4B delivers cutting-edge digital solutions to transform your operations. From workflow automation to real-time analytics, our platforms are designed to drive business success with precision and reliability.",
    img: beforeAfter,
    imgAlt: "Before and after implementing A4B's solutions.",
    btnExists: true,
    btnTitle: "Learn More",
    btnURL: "#",
  },
  {
    isRightSection: true,
    title: "Streamlining Processes with Intelligent Oversight",
    subTitle:
      "Effective process management is key to success. A4B provides comprehensive solutions for resource allocation, workflow optimization, and communication management, ensuring your business runs smoothly and efficiently.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Team collaborating on a digital workflow.",
    imgTwo: aerialView,
    imgTwoAlt: "Aerial view of optimized processes in action.",
  },
  {
    isRightSection: false,
    title: "Ensuring Long-term Success with Robust Support",
    subTitle:
      "Our commitment doesn't end with deployment. A4B offers ongoing support and updates to ensure your platforms remain effective and aligned with your business goals.",
    img: usingTools,
    imgAlt: "Team providing technical support and updates.",
  },
  {
    isRightSection: true,
    title: "Crafting Custom Strategies for Complex Needs",
    subTitle:
      "A4B partners with enterprises to design bespoke strategies tailored to their unique challenges. By leveraging advanced technologies, we drive innovation, enhance efficiency, and support sustainable growth.",
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: "Visualization of a scalable business platform.",
    imgTwo: underConstruction,
    imgTwoAlt: "Digital transformation framework under development.",
    btnExists: true,
    btnTitle: "Read more",
    btnURL: "#",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
   structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://a4b.com/services",
    "url": "https://a4b.com/services",
    "name": "Empowering Digital Transformation | A4B",
    "description": "A4B provides advanced digital solutions and services to help businesses navigate their digital transformation journey. From platform integration to custom strategies, we ensure success at every stage.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://a4b.com",
      "name": "A4B",
      "description": "A4B delivers cutting-edge digital solutions, empowering businesses with streamlined operations and user-centric platforms.",
    },
    "inLanguage": "en-US"
  }}
>
  <!--MainSection is the introductory section of the page, it also contains a CTA button-->
  <MainSection
    title="Empowering Digital Transformation"
    subTitle="At A4B, we provide comprehensive digital solutions tailored to your unique needs. From strategy to implementation, our team ensures your business thrives in the digital age with cutting-edge platforms and unmatched support."
    btnExists={true}
    btnTitle="Schedule a Consultation"
    btnURL="#"
  />
  <!-- RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  -->
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <!--FeaturesStats section showcases essential stats valuable to users-->
  <FeaturesStats
  title="Our Impact in Numbers"
  subTitle="A4B’s innovative solutions and client-centric approach have helped businesses achieve unprecedented growth and operational efficiency. Here’s what sets us apart."
  mainStatTitle="98%"
  mainStatSubTitle="of our clients report improved efficiency with A4B"
  stats={[
    {
      stat: "100%",
      description: "successful project delivery rate",
    },
    {
      stat: "10,000+",
      description: "businesses empowered worldwide",
    },
    {
      stat: "90%",
      description: "client retention rate year-over-year",
    },
  ]}
/>

</MainLayout>
